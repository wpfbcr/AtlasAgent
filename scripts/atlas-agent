#!/usr/bin/env bash
# AtlasAgent CLI — install, doctor, check-update
# Usage: atlas-agent install | doctor | check-update
set -euo pipefail

REPO_ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
ATLAS_ROOT="${ATLAS_ROOT:-$REPO_ROOT}"
export ATLAS_ROOT

log() { echo "$@"; }
ok() { echo "  ✓ $*"; }
warn() { echo "  ⚠ $*"; }
fail() { echo "  ✗ $*"; }

usage() {
  cat <<'EOF'
AtlasAgent — global travel planning skill pack

Usage:
  atlas-agent install [--env=auto|none] [--agent=all|cursor|claude|codex|copilot|hermes] [--overwrite] [--safe] [--dry-run]
  atlas-agent doctor [--json] [--offline]
  atlas-agent check-update

Environment:
  ATLAS_ROOT   Repository path (default: parent of this script)
EOF
}

cmd_doctor() {
  if ! command -v python3 >/dev/null 2>&1; then
    local wants_json=false
    for arg in "$@"; do [[ "$arg" == "--json" ]] && wants_json=true; done
    if $wants_json; then
      echo '{"status":"unavailable","python3":false,"error":"Python 3 not found"}'
    else
      fail "Python 3 not found"
    fi
    return 1
  fi
  python3 "$REPO_ROOT/scripts/doctor.py" "$@"
}

cmd_check_update() {
  if command -v gh >/dev/null 2>&1; then
    local remote
    remote="$(gh api repos/wpfbcr/AtlasAgent --jq '.pushed_at' 2>/dev/null || true)"
    log "Remote last push: ${remote:-unknown}"
    log "Local: $ATLAS_ROOT"
    log "Update: git -C \"$ATLAS_ROOT\" pull && bash \"$ATLAS_ROOT/scripts/install.sh\" all"
  else
    log "Run: git -C \"$ATLAS_ROOT\" pull"
    log "Then: bash \"$ATLAS_ROOT/scripts/install.sh\" all"
  fi
  log "Changed skills are preserved by default. After review, add --overwrite to replace them with backups."
}

cmd_install() {
  local agent="all" safe=false dry=false overwrite=false env_mode="auto"
  for arg in "$@"; do
    case "$arg" in
      --env=auto|--env=none) env_mode="${arg#*=}" ;;
      --agent=*) agent="${arg#*=}" ;;
      --safe) safe=true ;;
      --dry-run) dry=true ;;
      --overwrite) overwrite=true ;;
      --help|-h) usage; exit 0 ;;
      *) echo "Unknown install option: $arg" >&2; exit 1 ;;
    esac
  done
  case "$agent" in
    all|cursor|claude|codex|copilot|agents|hermes) ;;
    *) echo "Unknown agent: $agent" >&2; exit 1 ;;
  esac

  if $dry; then
    log "[dry-run] Would clone/use ATLAS_ROOT=$ATLAS_ROOT"
    log "[dry-run] Would install skills to agent=$agent"
    if $overwrite; then
      log "[dry-run] Would back up and replace changed skills"
    else
      log "[dry-run] Would stop if an existing skill differs"
    fi
    if ! $safe && [[ "$env_mode" == "auto" ]]; then log "[dry-run] Would update the managed ATLAS_ROOT block"; fi
    $safe || log "[dry-run] Would run: pip3 install fpdf2 (optional)"
    exit 0
  fi

  if $safe; then
    log "Safe mode — manual steps:"
    log "  1. git clone https://github.com/wpfbcr/AtlasAgent.git ~/AtlasAgent"
    log "  2. export ATLAS_ROOT=~/AtlasAgent"
    local safe_args=""
    if [[ "$env_mode" == "none" ]]; then safe_args=" --no-env"; fi
    if $overwrite; then
      log "  3. bash \"\$ATLAS_ROOT/scripts/install.sh\" $agent --overwrite$safe_args"
    else
      log "  3. bash \"\$ATLAS_ROOT/scripts/install.sh\" $agent$safe_args"
    fi
    log "  4. pip3 install fpdf2   # optional"
    log "  5. bash \"\$ATLAS_ROOT/scripts/atlas-agent\" doctor"
    exit 0
  fi

  local install_args=("$agent")
  if [[ "$env_mode" == "none" ]]; then install_args+=(--no-env); fi
  if $overwrite; then install_args+=(--overwrite); fi
  bash "$REPO_ROOT/scripts/install.sh" "${install_args[@]}"

  if ! python3 -c "import importlib.metadata; importlib.metadata.version('fpdf2')" 2>/dev/null; then
    python3 -m pip install -r "$REPO_ROOT/requirements-pdf.txt" -q 2>/dev/null && ok "Installed fpdf2" || warn "Could not auto-install fpdf2 — run: pip3 install fpdf2"
  fi

  log ""
  cmd_doctor
}

case "${1:-}" in
  install) shift; cmd_install "$@" ;;
  doctor) shift; cmd_doctor "$@" ;;
  check-update) shift; cmd_check_update ;;
  ""|-h|--help|help) usage ;;
  *) echo "Unknown command: $1"; usage; exit 1 ;;
esac
